{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "InstaCloud Docs",
  "colors": {
    "primary": "#07C983",
    "light": "#4ADE80",
    "dark": "#059669"
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "section"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-dark.svg"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "seo": {
    "metatags": {
      "og:site_name": "InstaCloud Docs"
    },
    "indexing": "navigable"
  },
  "search": {
    "prompt": "Search InstaCloud docs..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
