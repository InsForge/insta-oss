{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "InstaCloud Docs",
  "colors": {
    "primary": "#07C983",
    "light": "#4ADE80",
    "dark": "#059669"
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "section"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-dark.svg"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "banner": {
    "content": "InstaCloud docs are in early access — many pages are still being written. Missing something? [Open an issue](https://github.com/InsForge/insta-oss/issues).",
    "dismissible": true
  },
  "seo": {
    "metatags": {
      "og:site_name": "InstaCloud Docs — the agent-native cloud",
      "description": "InstaCloud is the agent-native cloud: Postgres, storage, and compute that branch per task, with one gated seam for credentials and humans in the approval loop."
    },
    "indexing": "navigable"
  },
  "search": {
    "prompt": "Search InstaCloud docs..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode",
      "mcp"
    ]
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
