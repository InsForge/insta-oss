{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "InstaCloud Docs",
  "colors": {
    "primary": "#07C983",
    "light": "#4ADE80",
    "dark": "#059669"
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "section"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-dark.svg"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "seo": {
    "metatags": {
      "og:site_name": "InstaCloud Docs"
    },
    "indexing": "navigable"
  },
  "search": {
    "prompt": "Search InstaCloud docs..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "self-host-quickstart",
              "agent-setup",
              "comparison"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/projects",
              "concepts/branches",
              "concepts/services",
              "concepts/secrets",
              "concepts/deploys",
              "concepts/governance",
              "concepts/environments",
              "concepts/organizations"
            ]
          },
          {
            "group": "Postgres",
            "pages": [
              "postgres/overview",
              "postgres/connect",
              "postgres/branching",
              "postgres/scale-to-zero",
              "postgres/sizing",
              "postgres/databases-and-roles",
              "postgres/backups",
              "postgres/extensions",
              "postgres/observability"
            ]
          },
          {
            "group": "Compute",
            "pages": [
              "compute/overview",
              "compute/deploy",
              "compute/ports-and-workers",
              "compute/volumes",
              "compute/sleep-and-wake",
              "compute/networking",
              "compute/custom-domains",
              "compute/logs-and-metrics",
              "compute/limits-and-scaling"
            ]
          },
          {
            "group": "Storage",
            "pages": [
              "storage/overview",
              "storage/access",
              "storage/objects"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "agents/overview",
              "agents/mcp-server",
              "agents/skills",
              "agents/branch-per-task",
              "agents/human-in-the-loop",
              "agents/observe"
            ]
          },
          {
            "group": "Self-hosting",
            "pages": [
              "self-hosting/overview",
              "self-hosting/install",
              "self-hosting/configuration",
              "self-hosting/architecture",
              "self-hosting/adapters",
              "self-hosting/managed-databases",
              "self-hosting/compatibility"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/github-deploys",
              "guides/frameworks",
              "guides/claude-code",
              "guides/cursor-and-codex",
              "guides/parallel-agents",
              "guides/migrate",
              "guides/ci"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/cli",
              "reference/mcp-tools",
              "reference/environment-variables",
              "reference/gated-actions",
              "reference/plans-and-limits",
              "reference/regions",
              "reference/errors",
              "reference/faq"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "InstaCloud (hosted)",
          "href": "https://instacloud.com",
          "icon": "cloud"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/InsForge/insta-oss",
          "icon": "github"
        },
        {
          "anchor": "Discord",
          "href": "https://discord.com/invite/MPxwj5xVvW",
          "icon": "discord"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/InsForge/insta-oss"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/InsForge_dev",
      "github": "https://github.com/InsForge/insta-oss"
    }
  },
  "redirects": [
    {
      "source": "/getting-started/self-host",
      "destination": "/self-hosting/install"
    },
    {
      "source": "/getting-started/first-project",
      "destination": "/quickstart"
    },
    {
      "source": "/concepts/projects-and-branches",
      "destination": "/concepts/branches"
    },
    {
      "source": "/reference/architecture",
      "destination": "/self-hosting/architecture"
    },
    {
      "source": "/reference/compatibility",
      "destination": "/self-hosting/compatibility"
    }
  ]
}
